diff --git a/scripts/get_icon_dwd.bash b/scripts/get_icon_dwd.bash
new file mode 100755
index 0000000..9e22926
--- /dev/null
+++ b/scripts/get_icon_dwd.bash
@@ -0,0 +1,278 @@
+#!/bin/bash
+umask 022
+#-----------------------------------------------------------------------------#
+# !SCRIPT: get_icon_dwd                                           [ICON/IFS]
+#
+# !DESCRIPTION:
+#     Baixa do DWD opendata o ICON global (malha icosaedrica R03B07, ~13 km,
+#     GRIB2 comprimido com bzip2) usado com EXP=ICON, e os pesos de
+#     remapeamento do CDO (so na primeira vez):
+#
+#        o ${DATAIN}/ICON/YYYYMMDDHH/*.grib2.bz2
+#        o ${DATAIN}/fixed/icon_cdo/{target_grid.txt,weights.nc}
+#        o ${DATAIN}/fixed/icon_hhl/*_HHL.grib2.bz2  (alturas dos niveis, 1 vez)
+#
+#     O DWD mantem so as rodadas das ultimas ~24 h (00, 06, 12 e 18 UTC).
+#     Solo, neve e gelo marinho sao baixados so na hora inicial; as LBCs
+#     (modo regional, a cada LBCINT) so precisam da atmosfera e da superficie.
+#
+#     ICON_VCOORD=model (padrao): atmosfera nos niveis do modelo do ICON.
+#        Os niveis sao escolhidos por icon_levels.py a partir do HHL e salvos
+#        em model_levels.txt: todos os niveis ate ICON_ZFULL (m acima do solo),
+#        acima disso um a cada ICON_THIN, e so UM nivel acima do topo do MONAN
+#        (ICON_ZTOP; vazio = config_ztop do namelist.init_atmosphere.TEMPLATE).
+#        Ao mudar algum deles, apague o model_levels.txt e o download_ok da rodada.
+#     ICON_VCOORD=pressure: os 18 niveis de pressao do opendata (1000-50 hPa).
+#
+#     Rodar de novo e seguro: arquivos completos nao sao baixados outra vez
+#     (wget -c) e, depois de um download completo (marcador download_ok), o
+#     DWD nem e consultado: a conversao pode ser refeita depois que a rodada
+#     saiu do opendata. Para forcar um novo download, apague o download_ok.
+#
+# !CALLING SEQUENCE:
+#     ./get_icon_dwd.bash LABELI FCST      (chamado pelo 2.pre_processing.bash)
+#-----------------------------------------------------------------------------#
+
+if [ $# -ne 2 ]
+then
+   echo ""
+   echo "Instructions: execute the command below"
+   echo ""
+   echo "${0} LABELI FCST"
+   echo ""
+   echo "LABELI      :: ICON run (YYYYMMDDHH, 00/06/12/18 UTC), one of the last ~24 h, e.g., $(date -u +%Y%m%d)00"
+   echo "FCST        :: Forecast length in hours (e.g., 24, 36, 48, etc.)"
+   echo ""
+   exit 1
+fi
+
+# Set environment variables exports:
+echo ""
+echo -e "\033[1;32m==>\033[0m Moduling environment for MONAN model...\n"
+. setenv.bash
+
+# Standart directories variables:---------------------------------------
+DIRHOMES=${DIR_SCRIPTS}/scripts_CD-CT;  mkdir -p ${DIRHOMES}
+DIRHOMED=${DIR_DADOS}/scripts_CD-CT;    mkdir -p ${DIRHOMED}
+SCRIPTS=${DIRHOMES}/scripts;            mkdir -p ${SCRIPTS}
+DATAIN=${DIRHOMED}/datain;              mkdir -p ${DATAIN}
+#----------------------------------------------------------------------
+
+# Input variables:--------------------------------------
+YYYYMMDDHHi=${1}; #YYYYMMDDHHi=2026110500
+FCST=${2};        #FCST=24
+#-------------------------------------------------------
+
+# Local variables--------------------------------------
+hhi=${YYYYMMDDHHi:8:2}
+BASEURL=https://opendata.dwd.de/weather/nwp/icon/grib/${hhi}
+OUT=${DATAIN}/ICON/${YYYYMMDDHHi};       mkdir -p ${OUT}
+ICONCDO=${DATAIN}/fixed/icon_cdo
+HHLDIR=${DATAIN}/fixed/icon_hhl
+NPROC=${ICON_NPROC:-8}
+VCOORD=${ICON_VCOORD:-model}
+#-------------------------------------------------------
+
+# Checagens rapidas (antes de qualquer download)--------
+if [[ ! ${hhi} =~ ^(00|06|12|18)$ ]]
+then
+   echo -e "${RED}==>${NC} ICON: LABELI must be a 00, 06, 12 or 18 UTC run (got ${YYYYMMDDHHi})."
+   exit 1
+fi
+if [[ ${VCOORD} != "model" && ${VCOORD} != "pressure" ]]
+then
+   echo -e "${RED}==>${NC} ICON_VCOORD must be model or pressure (got ${VCOORD})."
+   exit 1
+fi
+if [[ ${MODERUN} == "R" ]]
+then
+   # LBCs a cada LBCINT: o ICON tem saidas de hora em hora ate +78 h e de 3 em 3 h depois disso
+   if [ $((LBCINT % 3600)) -ne 0 ]
+   then
+      echo -e "${RED}==>${NC} ICON: LBCINT (${LBCINT} s, setenv.bash) must be a multiple of 3600 s."
+      exit 1
+   fi
+   dt=$((LBCINT / 3600))
+   # Horizonte do ICON global: 180 h nas rodadas 00/12 UTC, 120 h nas 06/18 UTC
+   if [[ ${hhi} == "00" || ${hhi} == "12" ]]; then maxf=180; else maxf=120; fi
+   if [ ${FCST} -gt ${maxf} ]
+   then
+      echo -e "${RED}==>${NC} ICON ${hhi} UTC runs go only up to +${maxf} h (FCST=${FCST})."
+      exit 1
+   fi
+   if [ ${FCST} -gt 78 ] && [ $((dt % 3)) -ne 0 ]
+   then
+      echo -e "${RED}==>${NC} ICON has 3-hourly output after +78 h: use LBCINT multiple of 10800 s or FCST <= 78."
+      exit 1
+   fi
+else
+   FCST=0; dt=1   # modo global: so a condicao inicial
+fi
+age=$(( ( $(date -u +%s) - $(date -u -d "${YYYYMMDDHHi:0:8} ${hhi}:00" +%s) ) / 3600 ))
+#-------------------------------------------------------
+
+# Python com numpy + eccodes (ICON_PYTHON ou ambiente conda; ver setenv.bash)
+PYTHON=$(find_python) || exit 1
+echo -e "${GREEN}==>${NC} Python for GRIB conversion: ${PYTHON}\n"
+
+# Pastas no DWD (minusculas) : nome da variavel nos arquivos (maiusculas)
+PL="t:T u:U v:V relhum:RELHUM fi:FI"
+ML="t:T u:U v:V qv:QV p:P"
+SL="ps:PS pmsl:PMSL t_2m:T_2M td_2m:TD_2M u_10m:U_10M v_10m:V_10M t_g:T_G"
+SL0="fr_ice:FR_ICE w_snow:W_SNOW h_snow:H_SNOW"
+SOIL0="t_so:T_SO w_so:W_SO"
+TI="hsurf:HSURF fr_land:FR_LAND"
+#-------------------------------------------------------
+
+
+# Rodada ja baixada por completo? O marcador download_ok guarda "FCST DT VCOORD". Se cobre o pedido
+# (mesmo DT e VCOORD, FCST >= o pedido) e os niveis escolhidos continuam la, nao consulta o DWD.
+if [ -s ${OUT}/download_ok ]
+then
+   read mfcst mdt mvcoord < ${OUT}/download_ok
+   if [[ ${mdt} == ${dt} && ${mvcoord} == ${VCOORD} && ${mfcst} -ge ${FCST} ]] && \
+      [[ ${VCOORD} != "model" || -s ${OUT}/model_levels.txt ]]
+   then
+      echo -e "${GREEN}==>${NC} ICON ${YYYYMMDDHHi} (+${mfcst} h, ${VCOORD} levels) already downloaded in ${OUT}. Skipping download.\n"
+      exit 0
+   fi
+fi
+
+if [ ${age} -gt 24 ]
+then
+   echo -e "${YELLOW}==>${NC} Warning: ICON ${YYYYMMDDHHi} is ${age} h old; DWD opendata keeps only the last ~24 h. Trying anyway...\n"
+fi
+
+
+# Pesos de remapeamento do CDO (ICON global R03B07 -> lat-lon 0.125 grau), uma vez:
+if [ ! -s ${ICONCDO}/target_grid.txt ] || [ ! -s ${ICONCDO}/weights.nc ]
+then
+   echo -e "${GREEN}==>${NC} Downloading CDO remapping weights from DWD...\n"
+   mkdir -p ${ICONCDO}
+   cd ${ICONCDO}
+   wget -c https://opendata.dwd.de/weather/lib/cdo/ICON_GLOBAL2WORLD_0125_EASY.tar.bz2 || exit 1
+   tar -xjf ICON_GLOBAL2WORLD_0125_EASY.tar.bz2 || exit 1
+   grid=$(find ${ICONCDO} -type f -name 'target_grid*.txt' | head -1)
+   weights=$(find ${ICONCDO} -type f -name 'weights*.nc' | head -1)
+   if [ -z "${grid}" ] || [ -z "${weights}" ]
+   then
+      echo -e "${RED}==>${NC} target_grid*.txt or weights*.nc not found in the tarball:"
+      find ${ICONCDO} -type f
+      exit 1
+   fi
+   ln -sf ${grid} target_grid.txt
+   ln -sf ${weights} weights.nc
+   rm -f ICON_GLOBAL2WORLD_0125_EASY.tar.bz2
+   cd - > /dev/null
+fi
+
+
+# Lista de arquivos:----------------------------------------------------
+# Campos com varios niveis de pressao/solo: nomes tirados da listagem da pasta no DWD
+listing () {
+   wget -qO- ${BASEURL}/${1}/ | grep -o "icon_global_icosahedral_${2}_${YYYYMMDDHHi}_[0-9]*_[0-9]*_${3}\.grib2\.bz2" | sort -u
+}
+
+if ! wget -qO- ${BASEURL}/ps/ | grep -q "single-level_${YYYYMMDDHHi}_000_PS"
+then
+   echo -e "${RED}==>${NC} ICON run ${YYYYMMDDHHi} not found at ${BASEURL}"
+   echo -e "${RED}==>${NC} DWD opendata keeps only the last ~24 h of runs (and a run appears ~3-4 h after its start)."
+   exit 1
+fi
+
+if [[ ${VCOORD} == "model" ]]
+then
+   # HHL (alturas das 121 meias-camadas), uma vez: nao muda entre rodadas
+   if [ $(ls ${HHLDIR}/*_HHL.grib2.bz2 2>/dev/null | wc -l) -lt 121 ]
+   then
+      echo -e "${GREEN}==>${NC} Downloading ICON HHL (model level heights) to ${HHLDIR}...\n"
+      mkdir -p ${HHLDIR}
+      for k in $(seq 1 121); do
+         echo "${BASEURL}/hhl/icon_global_icosahedral_time-invariant_${YYYYMMDDHHi}_${k}_HHL.grib2.bz2"
+      done | xargs -P ${NPROC} -n 1 wget -q -c -P ${HHLDIR}
+      if [ $(ls ${HHLDIR}/*_HHL.grib2.bz2 2>/dev/null | wc -l) -lt 121 ]
+      then
+         echo -e "${RED}==>${NC} HHL download incomplete in ${HHLDIR}. Run again to resume."
+         exit 1
+      fi
+   fi
+
+   # Topo do MONAN (m acima do nivel do mar): ICON_ZTOP ou config_ztop do namelist do init_atmosphere
+   ZTOP=${ICON_ZTOP:-$(nml_get ${SCRIPTS}/namelists/namelist.init_atmosphere.TEMPLATE config_ztop)}
+   if [ -z "${ZTOP}" ]
+   then
+      echo -e "${RED}==>${NC} config_ztop not found in ${SCRIPTS}/namelists/namelist.init_atmosphere.TEMPLATE (run 1.install_monan.bash or set ICON_ZTOP)."
+      exit 1
+   fi
+
+   # Niveis do modelo usados nesta rodada
+   if [ ! -s ${OUT}/model_levels.txt ]
+   then
+      echo -e "${GREEN}==>${NC} Selecting ICON model levels (icon_levels.py, ztop = ${ZTOP} m)...\n"
+      ${PYTHON} ${SCRIPTS}/icon_levels.py --hhl-dir ${HHLDIR} --ztop ${ZTOP} \
+         --zfull ${ICON_ZFULL:-16000} --thin ${ICON_THIN:-2} > ${OUT}/model_levels.txt
+      if [ $? -ne 0 ] || [ ! -s ${OUT}/model_levels.txt ]
+      then
+         rm -f ${OUT}/model_levels.txt
+         exit 1
+      fi
+   fi
+   MLEVELS=$(cat ${OUT}/model_levels.txt)
+   echo -e "\nICON model levels ($(echo ${MLEVELS} | wc -w)): ${MLEVELS}\n"
+fi
+
+urls=${OUT}/urls.txt; rm -f ${urls}
+for item in ${TI}; do
+   echo "${BASEURL}/${item%%:*}/icon_global_icosahedral_time-invariant_${YYYYMMDDHHi}_${item##*:}.grib2.bz2" >> ${urls}
+done
+if [[ ${VCOORD} == "model" ]]
+then
+   for ((hour=0; hour<=FCST; hour+=dt)); do
+      fff=$(printf "%03d" ${hour})
+      for item in ${ML}; do
+         for k in ${MLEVELS}; do
+            echo "${BASEURL}/${item%%:*}/icon_global_icosahedral_model-level_${YYYYMMDDHHi}_${fff}_${k}_${item##*:}.grib2.bz2" >> ${urls}
+         done
+      done
+   done
+else
+   for item in ${PL}; do
+      for f in $(listing ${item%%:*} pressure-level ${item##*:}); do
+         fff=$(echo ${f} | awk -F_ '{print $6}')
+         if [ $((10#${fff} % dt)) -eq 0 ] && [ $((10#${fff})) -le ${FCST} ]; then echo "${BASEURL}/${item%%:*}/${f}" >> ${urls}; fi
+      done
+   done
+fi
+for item in ${SOIL0}; do
+   for f in $(listing ${item%%:*} soil-level ${item##*:} | grep "_${YYYYMMDDHHi}_000_"); do
+      echo "${BASEURL}/${item%%:*}/${f}" >> ${urls}
+   done
+done
+for ((hour=0; hour<=FCST; hour+=dt)); do
+   fff=$(printf "%03d" ${hour})
+   vars=${SL}; [ ${hour} -eq 0 ] && vars="${SL} ${SL0}"
+   for item in ${vars}; do
+      echo "${BASEURL}/${item%%:*}/icon_global_icosahedral_single-level_${YYYYMMDDHHi}_${fff}_${item##*:}.grib2.bz2" >> ${urls}
+   done
+done
+#----------------------------------------------------------------------
+
+echo -e "${GREEN}==>${NC} Downloading $(wc -l < ${urls}) ICON files to ${OUT} (${NPROC} in parallel)...\n"
+xargs -P ${NPROC} -n 1 wget -q -c -P ${OUT} < ${urls}
+
+# Confere se veio tudo (horarios que ainda nao sairam no DWD tambem aparecem aqui)
+nmiss=0
+while read url; do
+   if [ ! -s ${OUT}/$(basename ${url}) ]; then echo "Missing: ${url}"; nmiss=$((nmiss + 1)); fi
+done < ${urls}
+nlev=$(grep -c "_000_[0-9]*_T\.grib2" ${urls})
+if [ ${nmiss} -ne 0 ] || [ ${nlev} -eq 0 ]
+then
+   echo -e "\n${RED}==>${NC} ${nmiss} files missing (${VCOORD} levels of T at +000 h: ${nlev})."
+   echo -e "${RED}==>${NC} If the run is still being published, wait and run again (downloads resume).\n"
+   exit 1
+fi
+
+rm -f ${urls}
+echo "${FCST} ${dt} ${VCOORD}" > ${OUT}/download_ok
+echo -e "\n${GREEN}==>${NC} ICON ${YYYYMMDDHHi} (+${FCST} h) downloaded: $(du -sh ${OUT} | cut -f1) in ${OUT}\n"
diff --git a/scripts/get_ifs_ecmwf.bash b/scripts/get_ifs_ecmwf.bash
new file mode 100755
index 0000000..ca55eb6
--- /dev/null
+++ b/scripts/get_ifs_ecmwf.bash
@@ -0,0 +1,260 @@
+#!/bin/bash
+umask 022
+#-----------------------------------------------------------------------------#
+# !SCRIPT: get_ifs_ecmwf                                          [ICON/IFS]
+#
+# !DESCRIPTION:
+#     Baixa o IFS (HRES) do ECMWF open data (GRIB2 em lat-lon regular) usado
+#     com EXP=IFS. Le o .index de cada arquivo do ECMWF e baixa so os campos
+#     necessarios (pedidos HTTP por faixa de bytes):
+#
+#        o ifs_pl.FFF.grib2  : t, u, v, r, gh em 14 niveis de pressao (1000-10 hPa)
+#        o ifs_sfc.FFF.grib2 : sp, msl, 2t, 2d, 10u, 10v, skt
+#        o ifs_sfc0.grib2    : z, lsm, sd, rsn, sithick (so a hora inicial)
+#        o ifs_sol.grib2     : sot, vsw nas 4 camadas de solo (so a hora inicial)
+#
+#     em ${DATAIN}/IFS/YYYYMMDDHH/ (FFF = hora de previsao).
+#
+#     Variaveis (setenv.bash):
+#     IFS_RESOL  = 0p1 (padrao), 0p25, ou 0p4-beta (datas antes de fev/2024)
+#     IFS_SOURCE = ecmwf (padrao; o portal guarda so os ~3 ultimos dias)
+#                  ou aws (arquivo do open data desde 2023)
+#     IFS_NPROC  = arquivos baixados em paralelo (padrao 8)
+#
+#     O stream e descoberto sozinho: "oper" (00/12 UTC, e 06/18 UTC nas datas
+#     recentes) ou "scda" (06/18 UTC em datas antigas). Arquivos ja baixados
+#     nao sao pedidos de novo (rodar outra vez e seguro e nao usa a rede).
+#
+# !CALLING SEQUENCE:
+#     ./get_ifs_ecmwf.bash LABELI FCST      (chamado pelo 2.pre_processing.bash)
+#-----------------------------------------------------------------------------#
+
+if [ $# -ne 2 ]
+then
+   echo ""
+   echo "Instructions: execute the command below"
+   echo ""
+   echo "${0} LABELI FCST"
+   echo ""
+   echo "LABELI      :: IFS run (YYYYMMDDHH), 00, 06, 12 or 18 UTC, e.g., $(date -u +%Y%m%d)00"
+   echo "FCST        :: Forecast length in hours (e.g., 24, 36, 48, etc.)"
+   echo ""
+   exit 1
+fi
+
+# Set environment variables exports:
+echo ""
+echo -e "\033[1;32m==>\033[0m Moduling environment for MONAN model...\n"
+. setenv.bash
+
+# Standart directories variables:---------------------------------------
+DIRHOMES=${DIR_SCRIPTS}/scripts_CD-CT;  mkdir -p ${DIRHOMES}
+DIRHOMED=${DIR_DADOS}/scripts_CD-CT;    mkdir -p ${DIRHOMED}
+DATAIN=${DIRHOMED}/datain;              mkdir -p ${DATAIN}
+#----------------------------------------------------------------------
+
+# Input variables:--------------------------------------
+YYYYMMDDHHi=${1}; #YYYYMMDDHHi=2026110500
+FCST=${2};        #FCST=24
+#-------------------------------------------------------
+
+# Local variables--------------------------------------
+hhi=${YYYYMMDDHHi:8:2}
+OUT=${DATAIN}/IFS/${YYYYMMDDHHi};       mkdir -p ${OUT}
+# O download so usa a biblioteca padrao do Python: qualquer python3 serve
+PYTHON=${ICON_PYTHON:-$(command -v python3)}
+#-------------------------------------------------------
+
+# Checagens rapidas (antes de qualquer download)--------
+if [[ ! ${hhi} =~ ^(00|06|12|18)$ ]]
+then
+   echo -e "${RED}==>${NC} IFS: LABELI must be a 00, 06, 12 or 18 UTC run (got ${YYYYMMDDHHi})."
+   exit 1
+fi
+if [[ ${MODERUN} == "R" ]]
+then
+   # Passos do IFS open data: de 3 em 3 h ate +144 h; depois de 6 em 6 h (so 00/12 UTC, ate +360 h)
+   if [ $((LBCINT % 10800)) -ne 0 ]
+   then
+      echo -e "${RED}==>${NC} IFS: LBCINT (${LBCINT} s, setenv.bash) must be a multiple of 10800 s (3 h)."
+      exit 1
+   fi
+   dt=$((LBCINT / 3600))
+   if [ ${FCST} -gt 144 ] && [ $((dt % 6)) -ne 0 ]
+   then
+      echo -e "${RED}==>${NC} IFS has 6-hourly output after +144 h: use LBCINT multiple of 21600 s or FCST <= 144."
+      exit 1
+   fi
+   if [[ ${hhi} == "06" || ${hhi} == "18" ]] && [ ${FCST} -gt 144 ]
+   then
+      echo -e "${RED}==>${NC} IFS 06/18 UTC runs go only up to +144 h (+90 h in older dates)."
+      exit 1
+   fi
+else
+   FCST=0; dt=3   # modo global: so a condicao inicial
+fi
+age=$(( ( $(date -u +%s) - $(date -u -d "${YYYYMMDDHHi:0:8} ${hhi}:00" +%s) ) / 3600 ))
+if [ ${age} -gt 72 ] && [[ ${IFS_SOURCE:-ecmwf} == "ecmwf" ]]
+then
+   echo -e "${YELLOW}==>${NC} Warning: IFS ${YYYYMMDDHHi} is ${age} h old; data.ecmwf.int keeps only ~3 days."
+   echo -e "${YELLOW}==>${NC} If it fails, use: export IFS_SOURCE=aws\n"
+fi
+#-------------------------------------------------------
+
+echo -e "${GREEN}==>${NC} Downloading IFS ${YYYYMMDDHHi} (+${FCST} h, every ${dt} h, ${IFS_RESOL:-0p1}, ${IFS_SOURCE:-ecmwf}, ${IFS_NPROC:-8} workers) to ${OUT} ...\n"
+
+${PYTHON} - ${YYYYMMDDHHi} ${FCST} ${dt} ${OUT} ${IFS_SOURCE:-ecmwf} ${IFS_RESOL:-0p1} ${IFS_NPROC:-8} << 'EOF' || exit 1
+import json
+import os
+import sys
+import threading
+import time
+import urllib.error
+import urllib.request
+from concurrent.futures import ThreadPoolExecutor, as_completed
+
+run, fcst, dt, out, source, resol = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), sys.argv[4], sys.argv[5], sys.argv[6]
+nproc = max(1, int(sys.argv[7]))
+roots = {"ecmwf": "https://data.ecmwf.int/forecasts",
+         "aws": "https://ecmwf-forecasts.s3.eu-central-1.amazonaws.com"}
+if source not in roots:
+    sys.exit(f"IFS_SOURCE must be one of {list(roots)}")
+if resol not in ("0p1", "0p25", "0p4-beta"):
+    sys.exit("IFS_RESOL must be 0p1, 0p25 or 0p4-beta")
+hh = run[8:10]
+
+PL = {"t", "u", "v", "r", "gh"}
+PLEVS = {"1000", "925", "850", "700", "600", "500", "400", "300", "250", "200", "150", "100", "50", "10"}
+SFC = {"sp", "msl", "2t", "2d", "10u", "10v", "skt"}
+SFC0 = {"z", "lsm", "sd", "rsn", "sithick"}
+SFC0_REQUIRED = {"z", "lsm", "sd"}
+SOL = {"sot", "vsw"}
+MAXCHUNK = 64 * 1024 * 1024
+
+
+class NotFound(Exception):
+    pass
+
+
+def url(step, kind, stream):
+    # 0p1: arquivos -pl e -sfc separados; 0p25 e 0p4-beta: um arquivo so
+    suffix = f"-{kind}" if kind else ""
+    return f"{roots[source]}/{run[:8]}/{hh}z/ifs/{resol}/{stream}/{run}0000-{step}h-{stream}-fc{suffix}"
+
+
+def get(u, headers=None):
+    for attempt in range(5):
+        try:
+            with urllib.request.urlopen(urllib.request.Request(u, headers=headers or {}), timeout=120) as r:
+                return r.read()
+        except urllib.error.HTTPError as err:
+            if err.code in (403, 404):
+                raise NotFound(u) from err
+            if attempt == 4:
+                sys.exit(f"Failed to download {u}: {err}")
+        except Exception as err:  # noqa: BLE001 (rede instavel: tenta de novo)
+            if attempt == 4:
+                sys.exit(f"Failed to download {u}: {err}")
+        time.sleep(10 * (attempt + 1))
+
+
+pl_kind = "pl" if resol == "0p1" else ""
+sfc_kind = "sfc" if resol == "0p1" else ""
+
+# Stream: "oper" (00/12 UTC e, nas datas recentes, 06/18 UTC) ou "scda" (06/18 UTC em datas antigas).
+# Descoberto so quando algum arquivo precisa ser baixado (se ja estiver tudo em disco, nao usa a rede).
+_stream = []
+_lock = threading.Lock()
+def stream_name():
+    with _lock:
+        if not _stream:
+            for cand in ("oper", "scda") if hh in ("06", "18") else ("oper",):
+                try:
+                    get(url(0, sfc_kind, cand) + ".index")
+                    _stream.append(cand)
+                    break
+                except NotFound:
+                    pass
+            if not _stream:
+                sys.exit(f"IFS run {run} ({resol}) not found at {roots[source]}.\n"
+                         f"data.ecmwf.int keeps only ~3 days (older runs: IFS_SOURCE=aws); 0p1 exists only "
+                         f"for recent dates (try IFS_RESOL=0p25); before Feb/2024 use IFS_RESOL=0p4-beta.")
+            print(f"IFS stream: {_stream[0]}", flush=True)
+        return _stream[0]
+
+
+index_cache = {}
+def records(step, kind):
+    key = (step, kind)
+    if key not in index_cache:
+        u = url(step, kind, stream_name())
+        try:
+            lines = get(u + ".index").decode().splitlines()
+        except NotFound:
+            sys.exit(f"Step +{step} h not found ({u}.index): not published yet, "
+                     f"or beyond the forecast range of this run.")
+        index_cache[key] = [json.loads(line) for line in lines if line.strip()]
+    return index_cache[key]
+
+
+def download(name, parts, check):
+    """Junta em out/name os campos escolhidos de cada (passo, arquivo)."""
+    target = os.path.join(out, name)
+    if os.path.exists(target):
+        print(f"{name} already exists")
+        return
+    got = []
+    with open(target + ".part", "wb") as f:
+        for step, kind, select in parts:
+            # Campos vizinhos no arquivo do ECMWF viram um pedido so (ate MAXCHUNK bytes)
+            ranges = []
+            for rec in sorted((r for r in records(step, kind) if select(r)), key=lambda r: r["_offset"]):
+                off, length = rec["_offset"], rec["_length"]
+                if ranges and ranges[-1][1] == off and off + length - ranges[-1][0] <= MAXCHUNK:
+                    ranges[-1][1] = off + length
+                else:
+                    ranges.append([off, off + length])
+                got.append((rec["param"], rec.get("levelist")))
+            for start, end in ranges:
+                f.write(get(url(step, kind, stream_name()) + ".grib2", {"Range": f"bytes={start}-{end - 1}"}))
+    check(name, got)
+    os.rename(target + ".part", target)
+    print(f"{name}: {len(got)} fields", flush=True)
+
+
+def need(expected):
+    def check(name, got):
+        missing = sorted(expected - set(got))
+        if missing:
+            sys.exit(f"{name}: fields missing in the ECMWF files: {missing}")
+    return check
+
+
+jobs = [
+    ("ifs_sfc0.grib2", [(0, sfc_kind, lambda r: r["levtype"] == "sfc" and r["param"] in SFC0)],
+     need({(p, None) for p in SFC0_REQUIRED})),
+    ("ifs_sol.grib2", [(0, sfc_kind, lambda r: r["levtype"] == "sol" and r["param"] in SOL)],
+     need({(p, str(k)) for p in SOL for k in range(1, 5)})),
+]
+for step in range(0, fcst + 1, dt):
+    jobs.append((f"ifs_pl.{step:03d}.grib2",
+                 [(step, pl_kind, lambda r: r["levtype"] == "pl" and r["param"] in PL and r.get("levelist") in PLEVS)],
+                 need({(p, lev) for p in PL for lev in PLEVS})))
+    jobs.append((f"ifs_sfc.{step:03d}.grib2",
+                 [(step, sfc_kind, lambda r: r["levtype"] == "sfc" and r["param"] in SFC)],
+                 need({(p, None) for p in SFC})))
+
+# Um arquivo de saida por worker (IFS_NPROC); o primeiro erro interrompe tudo
+print(f"{len(jobs)} files with {nproc} workers", flush=True)
+with ThreadPoolExecutor(nproc) as pool:
+    futures = [pool.submit(download, *job) for job in jobs]
+    try:
+        for fut in as_completed(futures):
+            fut.result()
+    except BaseException:
+        for fut in futures:
+            fut.cancel()
+        raise
+EOF
+
+echo -e "\n${GREEN}==>${NC} IFS ${YYYYMMDDHHi} (+${FCST} h) downloaded: $(du -sh ${OUT} | cut -f1) in ${OUT}\n"
diff --git a/scripts/icon2wps.py b/scripts/icon2wps.py
new file mode 100755
index 0000000..8e19aa9
--- /dev/null
+++ b/scripts/icon2wps.py
@@ -0,0 +1,467 @@
+#!/usr/bin/env python3
+#-----------------------------------------------------------------------------#
+# !SCRIPT: icon2wps.py                                           [ICON/IFS]
+#
+# !DESCRIPTION:
+#     Converte o ICON global do DWD (malha icosaedrica, GRIB2 do opendata) em
+#     arquivos intermediarios do WPS (<PREFIX>:YYYY-MM-DD_HH), lidos direto pelo
+#     init_atmosphere do MONAN (config_met_prefix = '<PREFIX>').
+#
+#     Faz o papel do ungrib para o ICON:
+#        o bunzip2 + cdo remap (pesos do DWD) para lat-lon 0.125 + recorte
+#        o renomeia os campos para os nomes do WPS (TT, UU, VV, RH, GHT, ...)
+#        o atmosfera nos niveis do modelo (--vcoord model): T, U, V, QV e P do
+#          ICON, com GHT do HHL e o campo 3D PRESSURE; xlvl = numero do nivel
+#          (1 = topo), como nos niveis de modelo do ECMWF
+#        o ou nos 18 niveis de pressao do opendata (--vcoord pressure)
+#        o calcula a umidade especifica (SPECHUMD) e a UR em 2 m
+#        o umidade do solo: kg m-2 por camada -> m3 m-3
+#        o reagrupa o solo do ICON nas camadas do GFS (0-10/10-40/40-100/100-200 cm)
+#        o LANDSEA = FR_LAND >= 0.5
+#
+#     As profundidades do solo e os niveis de pressao vem das chaves GRIB2 de
+#     cada arquivo (os rotulos dos nomes do DWD misturam mm e cm no T_SO).
+#
+#     Requer: numpy, eccodes (python) e cdo.
+#
+# !CALLING SEQUENCE:
+#     icon2wps.py --indir DIR --run YYYYMMDDHH --fcst 48 --step 3 \
+#                 --grid target_grid.txt --weights weights.nc --outdir DIR
+#
+#-----------------------------------------------------------------------------#
+
+import argparse
+import datetime as dt
+import glob
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+from concurrent.futures import ThreadPoolExecutor
+
+import eccodes
+import numpy as np
+
+G = 9.80665
+RD = 287.04
+
+# Fonte gravada no cabecalho de cada campo do intermediario (so informativo; o ifs2wps.py troca)
+MAP_SOURCE = "DWD ICON"
+
+# Niveis de pressao: variavel do ICON -> nome no WPS
+PL_VARS = {"T": "TT", "U": "UU", "V": "VV", "RELHUM": "RH", "FI": "GHT"}
+# Niveis do modelo (QV = umidade especifica, P = pressao)
+ML_VARS = ["T", "U", "V", "QV", "P"]
+# Superficie, em todos os horarios
+SL_VARS = ["PS", "PMSL", "T_2M", "TD_2M", "U_10M", "V_10M", "T_G"]
+# Superficie e solo, so na hora inicial (as LBCs nao usam)
+SL0_VARS = ["FR_ICE", "W_SNOW", "H_SNOW"]
+SOIL_VARS = ["T_SO", "W_SO"]
+# Invariantes no tempo
+TI_VARS = ["HSURF", "FR_LAND"]
+
+# Camadas de solo de destino (m)
+SOIL_LAYERS = [(0.0, 0.1), (0.1, 0.4), (0.4, 1.0), (1.0, 2.0)]
+
+
+def parse_args():
+    p = argparse.ArgumentParser(description="ICON (DWD opendata) -> intermediarios do WPS")
+    p.add_argument("--indir", required=True, help="pasta com os *.grib2.bz2 da rodada")
+    p.add_argument("--run", required=True, help="rodada do ICON (YYYYMMDDHH)")
+    p.add_argument("--fcst", type=int, default=0, help="horas de previsao (0 = so a CI)")
+    p.add_argument("--step", type=int, default=3, help="intervalo entre horarios (h)")
+    p.add_argument("--grid", required=True, help="grade de destino do CDO (target_grid*.txt)")
+    p.add_argument("--weights", required=True, help="pesos de remapeamento do CDO (weights*.nc)")
+    p.add_argument("--box", default="global",
+                   help="recorte lon1,lon2,lat1,lat2 (sellonlatbox) ou 'global'")
+    p.add_argument("--vcoord", choices=["model", "pressure"], default="model",
+                   help="atmosfera nos niveis do modelo ou nos niveis de pressao")
+    p.add_argument("--hhl-dir", help="pasta com os *_HHL.grib2.bz2 (obrigatoria com --vcoord model)")
+    p.add_argument("--prefix", default="ICON", help="prefixo dos intermediarios")
+    p.add_argument("--cdo", default="cdo", help="executavel do cdo")
+    p.add_argument("--nproc", type=int, default=8, help="arquivos processados em paralelo")
+    p.add_argument("--outdir", required=True, help="pasta de saida")
+    return p.parse_args()
+
+
+#
+# Leitura e remapeamento
+#
+
+def fixed_surface(gid, which):
+    """Valor (unidades SI) da superficie First/Second de uma mensagem GRIB2, ou None."""
+    key = f"scaledValueOf{which}FixedSurface"
+    if eccodes.codes_is_missing(gid, key):
+        return None
+    value = eccodes.codes_get(gid, key)
+    fkey = f"scaleFactorOf{which}FixedSurface"
+    factor = 0 if eccodes.codes_is_missing(gid, fkey) else eccodes.codes_get(gid, fkey)
+    return value * 10.0 ** (-factor)
+
+
+def read_level(path):
+    """(topo, base) do nivel do primeiro registro: Pa nos niveis de pressao, m no solo."""
+    with open(path, "rb") as f:
+        gid = eccodes.codes_grib_new_from_file(f)
+        try:
+            return fixed_surface(gid, "First"), fixed_surface(gid, "Second")
+        finally:
+            eccodes.codes_release(gid)
+
+
+def read_latlon(path):
+    """Campo lat-lon (sul -> norte) e sua geometria (lat1, lon1, dlat, dlon, nj, ni)."""
+    with open(path, "rb") as f:
+        gid = eccodes.codes_grib_new_from_file(f)
+        try:
+            ni = eccodes.codes_get(gid, "Ni")
+            nj = eccodes.codes_get(gid, "Nj")
+            lat1 = eccodes.codes_get(gid, "latitudeOfFirstGridPointInDegrees")
+            lon1 = eccodes.codes_get(gid, "longitudeOfFirstGridPointInDegrees")
+            dlat = eccodes.codes_get(gid, "jDirectionIncrementInDegrees")
+            dlon = eccodes.codes_get(gid, "iDirectionIncrementInDegrees")
+            south_first = eccodes.codes_get(gid, "jScansPositively") == 1
+            values = eccodes.codes_get_values(gid).reshape(nj, ni)
+            if eccodes.codes_get(gid, "bitmapPresent"):
+                values = np.where(values == eccodes.codes_get(gid, "missingValue"), np.nan, values)
+        finally:
+            eccodes.codes_release(gid)
+    if not south_first:
+        values = values[::-1]
+        lat1 = lat1 - (nj - 1) * dlat
+    if lon1 > 180.0:
+        lon1 -= 360.0
+    return values.astype(np.float32), (round(lat1, 6), round(lon1, 6), dlat, dlon, nj, ni)
+
+
+def regrid(path, args, tmpdir):
+    """bunzip2 + cdo remap/recorte de um arquivo do ICON -> (arquivo nativo, arquivo lat-lon).
+
+    Roda nas threads; a leitura com eccodes fica na thread principal."""
+    td = tempfile.mkdtemp(dir=tmpdir)
+    native = os.path.join(td, "native.grib2")
+    latlon = os.path.join(td, "latlon.grib2")
+    with open(native, "wb") as fo:
+        subprocess.run(["bunzip2", "-c", path], stdout=fo, check=True)
+    remap = f"remap,{args.grid},{args.weights}"
+    if args.box == "global":
+        ops = [remap]
+    else:
+        ops = [f"sellonlatbox,{args.box}", "-" + remap]
+    # cdo com caminho completo (ex.: do conda) roda sem o LD_LIBRARY_PATH do
+    # setenv.bash, para usar as proprias bibliotecas e nao as do compilador do modelo (em alguns sistemas
+    # Cray, o cdo de modulo falha com "CCE OpenMP fatal error: omp_set_num_threads ...")
+    env = None
+    if os.path.isabs(args.cdo):
+        env = {k: v for k, v in os.environ.items() if k != "LD_LIBRARY_PATH"}
+    run = subprocess.run([args.cdo, "-s", "-f", "grb2", "-b", "F32", *ops, native, latlon],
+                         env=env, stderr=subprocess.PIPE, text=True)
+    # O ecCodes reclama da secao local (section2Padding) dos GRIB do DWD ao
+    # regravar; e inofensivo, entao so as outras mensagens vao para o log
+    msgs = [m for m in run.stderr.splitlines() if "section2Padding" not in m]
+    if msgs:
+        print("\n".join(msgs), file=sys.stderr, flush=True)
+    if run.returncode != 0:
+        raise subprocess.CalledProcessError(run.returncode, run.args)
+    return native, latlon
+
+
+def file_name(run, kind, var, fff=None):
+    if kind == "time-invariant":
+        return f"icon_global_icosahedral_time-invariant_{run}_{var}.grib2.bz2"
+    if kind == "single-level":
+        return f"icon_global_icosahedral_single-level_{run}_{fff}_{var}.grib2.bz2"
+    return f"icon_global_icosahedral_{kind}_{run}_{fff}_*_{var}.grib2.bz2"
+
+
+def level_of(path, native):
+    """Nivel de um arquivo: numero do nivel (niveis do modelo e HHL) ou chaves do GRIB."""
+    parts = os.path.basename(path).split("_")
+    if parts[3] == "model-level":
+        return int(parts[6]), None
+    if parts[-1].startswith("HHL."):
+        return int(parts[5]), None
+    return read_level(native)
+
+
+def find_jobs(args, fff):
+    """Lista (variavel, arquivo) de um horario; aborta se faltar algum arquivo."""
+    if args.vcoord == "model":
+        groups = [("model-level", ML_VARS), ("single-level", SL_VARS)]
+    else:
+        groups = [("pressure-level", list(PL_VARS)), ("single-level", SL_VARS)]
+    if fff == "000":
+        groups += [("single-level", SL0_VARS), ("soil-level", SOIL_VARS)]
+    jobs, missing = [], []
+    for kind, variables in groups:
+        for var in variables:
+            pattern = os.path.join(args.indir, file_name(args.run, kind, var, fff))
+            files = sorted(glob.glob(pattern))
+            if not files:
+                missing.append(pattern)
+            jobs += [(var, f) for f in files]
+    if missing:
+        sys.exit("Arquivos do ICON ausentes:\n  " + "\n  ".join(missing))
+    return jobs
+
+
+def process(pool, args, jobs, tmpdir):
+    """Remapeia os arquivos em paralelo -> {variavel: [(nivel, campo), ...]}, geometria."""
+    out, geo0 = {}, None
+    results = pool.map(lambda job: regrid(job[1], args, tmpdir), jobs)
+    for (var, path), (native, latlon) in zip(jobs, results):
+        level = level_of(path, native)
+        field, geo = read_latlon(latlon)
+        shutil.rmtree(os.path.dirname(native))
+        if geo0 is None:
+            geo0 = geo
+        elif geo != geo0:
+            sys.exit(f"Grade diferente em {path}: {geo} != {geo0}")
+        out.setdefault(var, []).append((level, field))
+    return out, geo0
+
+
+#
+# Conversoes
+#
+
+def esat(t):
+    """Pressao de vapor de saturacao (Pa) sobre agua, Bolton (1980)."""
+    return 611.2 * np.exp(17.67 * (t - 273.15) / (t - 29.65))
+
+
+def spechum(e, p):
+    return np.clip(0.622 * e / (p - 0.378 * e), 0.0, None)
+
+
+def fill_underground(cube, plev):
+    """Preenche pontos sem dado (abaixo do relevo) a partir do nivel de cima."""
+    t, fi = cube["T"], cube["FI"]
+    for k in range(1, len(plev)):
+        ratio = plev[k] / plev[k - 1]
+        miss = np.isnan(t[k])
+        t[k][miss] = t[k - 1][miss] * ratio ** (RD * 0.0065 / G)
+        miss = np.isnan(fi[k])
+        tm = 0.5 * (t[k] + t[k - 1])
+        fi[k][miss] = fi[k - 1][miss] - RD * tm[miss] * np.log(ratio)
+        for var in ("U", "V", "RELHUM"):
+            miss = np.isnan(cube[var][k])
+            cube[var][k][miss] = cube[var][k - 1][miss]
+
+
+def pressure_fields(res):
+    """Campos 3D (niveis do topo para a base) -> lista de (nome, unidade, descricao, nivel, campo)."""
+    plev = sorted(level[0] for level, _ in res["T"])
+    cube = {}
+    for var in PL_VARS:
+        by_p = {level[0]: field for level, field in res[var]}
+        if sorted(by_p) != plev:
+            sys.exit(f"{var}: niveis de pressao diferentes dos de T")
+        cube[var] = np.stack([by_p[p] for p in plev])
+    fill_underground(cube, plev)
+    for var, data in cube.items():
+        if np.isnan(data).any():
+            sys.exit(f"{var}: pontos sem dado mesmo depois do preenchimento")
+
+    fields = []
+    for k, p in enumerate(plev):
+        e = np.clip(cube["RELHUM"][k], 0.0, 100.0) / 100.0 * esat(cube["T"][k])
+        fields += [
+            ("TT", "K", "Temperature", p, cube["T"][k]),
+            ("UU", "m s-1", "U", p, cube["U"][k]),
+            ("VV", "m s-1", "V", p, cube["V"][k]),
+            ("RH", "%", "Relative Humidity", p, cube["RELHUM"][k]),
+            ("SPECHUMD", "kg kg-1", "Specific Humidity", p, spechum(e, p)),
+            ("GHT", "m", "Height", p, cube["FI"][k] / G),
+        ]
+    return fields, len(plev)
+
+
+def model_fields(res, hhl):
+    """Campos 3D nos niveis do modelo (xlvl = numero do nivel do ICON, 1 = topo).
+
+    O init_atmosphere usa o campo 3D PRESSURE (em vez do xlvl) e o GHT, que vem
+    da media das meias-camadas HHL acima e abaixo de cada nivel."""
+    levels = sorted(level[0] for level, _ in res["T"])
+    cube = {}
+    for var in ML_VARS:
+        by_k = {level[0]: field for level, field in res[var]}
+        if sorted(by_k) != levels:
+            sys.exit(f"{var}: niveis do modelo diferentes dos de T")
+        cube[var] = by_k
+
+    fields = []
+    for k in levels:
+        t, p = cube["T"][k], cube["P"][k]
+        q = np.clip(cube["QV"][k], 0.0, None)
+        e = q * p / (0.622 + 0.378 * q)
+        xlvl = float(k)
+        fields += [
+            ("TT", "K", "Temperature", xlvl, t),
+            ("UU", "m s-1", "U", xlvl, cube["U"][k]),
+            ("VV", "m s-1", "V", xlvl, cube["V"][k]),
+            ("SPECHUMD", "kg kg-1", "Specific Humidity", xlvl, q),
+            ("RH", "%", "Relative Humidity", xlvl, np.clip(100.0 * e / esat(t), 0.0, 100.0)),
+            ("PRESSURE", "Pa", "Pressure", xlvl, p),
+            ("GHT", "m", "Height", xlvl, 0.5 * (hhl[k] + hhl[k + 1])),
+        ]
+    for name, _, _, xlvl, data in fields:
+        if np.isnan(data).any():
+            sys.exit(f"{name} no nivel {xlvl:.0f}: campo com pontos sem dado")
+    return fields, len(levels)
+
+
+def soil_fields(res, skintemp):
+    """Solo do ICON -> SM/ST nas camadas do GFS."""
+    # Umidade: kg m-2 por camada -> m3 m-3, media ponderada pela sobreposicao
+    layers = [(level, field) for level, field in res["W_SO"]]
+    if any(bot is None for (_, bot), _ in layers):
+        sys.exit("W_SO sem a base da camada (Second fixed surface) no GRIB")
+    fields = []
+    for top, bot in SOIL_LAYERS:
+        acc = np.zeros_like(skintemp)
+        covered = 0.0
+        for (ltop, lbot), w in layers:
+            overlap = min(bot, lbot) - max(top, ltop)
+            if overlap > 0:
+                acc += np.nan_to_num(w) / (1000.0 * (lbot - ltop)) * overlap
+                covered += overlap
+        if abs(covered - (bot - top)) > 1e-6:
+            sys.exit(f"Camadas do W_SO nao cobrem {top}-{bot} m")
+        name = f"SM{round(top * 100):03d}{round(bot * 100):03d}"
+        fields.append((name, "m3 m-3", "Soil moisture", 200100.0, acc / (bot - top)))
+
+    # Temperatura: interpolacao linear no meio de cada camada
+    levels = sorted((level[0], field) for level, field in res["T_SO"])
+    depths = np.array([d for d, _ in levels])
+    tso = np.stack([f for _, f in levels])
+    for top, bot in SOIL_LAYERS:
+        z = 0.5 * (top + bot)
+        k = int(np.searchsorted(depths, z)) - 1
+        if k < 0 or k + 1 >= len(depths):
+            sys.exit(f"T_SO nao cobre a profundidade {z} m (niveis: {depths})")
+        w = (z - depths[k]) / (depths[k + 1] - depths[k])
+        layer = (1.0 - w) * tso[k] + w * tso[k + 1]
+        name = f"ST{round(top * 100):03d}{round(bot * 100):03d}"
+        fields.append((name, "K", "Soil temperature", 200100.0,
+                       np.where(np.isnan(layer), skintemp, layer)))
+    return fields
+
+
+def surface_fields(res, ti, initial):
+    one = {var: res[var][0][1] for var in SL_VARS + (SL0_VARS if initial else [])}
+    ps, t2, td2 = one["PS"], one["T_2M"], one["TD_2M"]
+    e = esat(td2)
+    fields = [
+        ("PSFC", "Pa", "Surface Pressure", 200100.0, ps),
+        ("PMSL", "Pa", "Sea-level Pressure", 201300.0, one["PMSL"]),
+        ("TT", "K", "Temperature", 200100.0, t2),
+        ("RH", "%", "Relative Humidity", 200100.0, np.clip(100.0 * e / esat(t2), 0.0, 100.0)),
+        ("SPECHUMD", "kg kg-1", "Specific Humidity", 200100.0, spechum(e, ps)),
+        ("UU", "m s-1", "U", 200100.0, one["U_10M"]),
+        ("VV", "m s-1", "V", 200100.0, one["V_10M"]),
+        ("SKINTEMP", "K", "Skin temperature", 200100.0, one["T_G"]),
+        ("SOILHGT", "m", "Terrain field of source analysis", 200100.0, ti["HSURF"]),
+        ("LANDSEA", "proprtn", "Land/Sea flag (1=land, 0=sea)", 200100.0, ti["LANDSEA"]),
+    ]
+    if initial:
+        fields += [
+            ("SEAICE", "proprtn", "Ice flag", 200100.0, np.nan_to_num(one["FR_ICE"])),
+            ("SNOW", "kg m-2", "Water equivalent snow depth", 200100.0, np.nan_to_num(one["W_SNOW"])),
+            ("SNOWH", "m", "Physical Snow Depth", 200100.0, np.nan_to_num(one["H_SNOW"])),
+        ]
+        fields += soil_fields(res, one["T_G"])
+    for name, _, _, _, data in fields:
+        if np.isnan(data).any():
+            sys.exit(f"{name}: campo com pontos sem dado")
+    return fields
+
+
+#
+# Escrita do intermediario do WPS
+#
+
+def write_record(f, payload):
+    marker = struct.pack(">i", len(payload))
+    f.write(marker + payload + marker)
+
+
+def write_field(f, hdate, geo, field, units, desc, xlvl, slab):
+    lat1, lon1, dlat, dlon, nj, ni = geo
+    write_record(f, struct.pack(">i", 5))
+    write_record(f, struct.pack(">24sf32s9s25s46sf3i",
+                                hdate.ljust(24).encode(), 0.0, MAP_SOURCE.ljust(32).encode(),
+                                field.ljust(9).encode(), units.ljust(25).encode(),
+                                desc.ljust(46).encode(), xlvl, ni, nj, 0))
+    write_record(f, struct.pack(">8s5f", b"SWCORNER", lat1, lon1, dlat, dlon, 6371.229))
+    write_record(f, struct.pack(">i", 0))   # is_wind_grid_rel = .false.
+    write_record(f, np.ascontiguousarray(slab, dtype=">f4").tobytes())
+
+
+def main():
+    args = parse_args()
+    run = dt.datetime.strptime(args.run, "%Y%m%d%H")
+    os.makedirs(args.outdir, exist_ok=True)
+    tmpdir = tempfile.mkdtemp(prefix="icon2wps_", dir=args.outdir)
+    try:
+        with ThreadPoolExecutor(args.nproc) as pool:
+            jobs = [(v, os.path.join(args.indir, file_name(args.run, "time-invariant", v)))
+                    for v in TI_VARS]
+            missing = [path for _, path in jobs if not os.path.isfile(path)]
+
+            # Niveis do modelo: os mesmos baixados para a hora inicial, mais as
+            # meias-camadas HHL acima (k) e abaixo (k+1) de cada um
+            if args.vcoord == "model":
+                if not args.hhl_dir:
+                    sys.exit("--hhl-dir e obrigatorio com --vcoord model")
+                t0 = glob.glob(os.path.join(args.indir, file_name(args.run, "model-level", "T", "000")))
+                levels = sorted(int(os.path.basename(f).split("_")[6]) for f in t0)
+                if not levels:
+                    sys.exit(f"Nenhum arquivo de T nos niveis do modelo em {args.indir}")
+                for k in sorted({h for lev in levels for h in (lev, lev + 1)}):
+                    pattern = os.path.join(args.hhl_dir,
+                                           f"icon_global_icosahedral_time-invariant_*_{k}_HHL.grib2.bz2")
+                    files = glob.glob(pattern)
+                    if files:
+                        jobs.append(("HHL", files[0]))
+                    else:
+                        missing.append(pattern)
+
+            if missing:
+                sys.exit("Arquivos do ICON ausentes:\n  " + "\n  ".join(missing))
+            res, geo_ti = process(pool, args, jobs, tmpdir)
+            ti = {"HSURF": np.nan_to_num(res["HSURF"][0][1]),
+                  "LANDSEA": (np.nan_to_num(res["FR_LAND"][0][1]) >= 0.5).astype(np.float32)}
+            hhl = {level[0]: field for level, field in res.get("HHL", [])}
+
+            for hour in range(0, args.fcst + 1, args.step):
+                fff = f"{hour:03d}"
+                valid = run + dt.timedelta(hours=hour)
+                hdate = f"{valid:%Y-%m-%d_%H}:00:00"
+                jobs = find_jobs(args, fff)
+                print(f"{hdate}: remapeando {len(jobs)} arquivos ...", flush=True)
+                res, geo = process(pool, args, jobs, tmpdir)
+                if geo != geo_ti:
+                    sys.exit(f"Grade dos invariantes {geo_ti} != grade de {fff} {geo}")
+
+                if args.vcoord == "model":
+                    fields, nlev = model_fields(res, hhl)
+                else:
+                    fields, nlev = pressure_fields(res)
+                fields += surface_fields(res, ti, initial=(hour == 0))
+
+                out = os.path.join(args.outdir, f"{args.prefix}:{valid:%Y-%m-%d_%H}")
+                with open(out, "wb") as f:
+                    for name, units, desc, xlvl, data in fields:
+                        write_field(f, hdate, geo, name, units, desc, xlvl, data)
+                kind = "do modelo" if args.vcoord == "model" else "de pressao"
+                print(f"   -> {out} ({len(fields)} campos, {nlev} niveis {kind}, "
+                      f"grade {geo[5]}x{geo[4]})", flush=True)
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+
+if __name__ == "__main__":
+    main()
